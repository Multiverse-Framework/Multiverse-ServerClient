# Tools
CC = cl
LIBTOOL = lib
LINK = link

# Output folders
LIBDIR = .\..\lib\windows

# Flags
CFLAGS = /EHsc /c /O2 /MD /I..\ext\include /I..\ext
LDFLAGS = /DLL /LIBPATH:$(LIBDIR)

# Source files
SRCS_CLIENT = multiverse_client.cpp
SRCS_JSON   = multiverse_client_json.cpp

# Object files
OBJS_CLIENT = $(SRCS_CLIENT:.cpp=.obj)
OBJS_JSON   = $(SRCS_JSON:.cpp=.obj)

# Static libraries
STATIC_LIB_CLIENT = $(LIBDIR)\multiverse_client.lib
STATIC_LIB_JSON   = $(LIBDIR)\multiverse_client_json.lib

# DLL and import libraries
DLL_CLIENT = $(LIBDIR)\multiverse_client.dll
IMPLIB_CLIENT = $(LIBDIR)\multiverse_client.lib

DLL_JSON = $(LIBDIR)\multiverse_client_json.dll
IMPLIB_JSON = $(LIBDIR)\multiverse_client_json.lib

# ==== Variants ====
VARIANTS = zmq tcp udp all
DEFS_zmq = /DUSE_ZMQ /DUSE_TCP=0 /DUSE_UDP=0
DEFS_tcp = /DUSE_ZMQ=0 /DUSE_TCP /DUSE_UDP=0
DEFS_udp = /DUSE_ZMQ=0 /DUSE_TCP=0 /DUSE_UDP
DEFS_all = /DUSE_ZMQ /DUSE_TCP /DUSE_UDP

# Default rule: build both base and variants
all: static shared variants
	del /Q *.obj *.exp

# ===== STATIC LIBS =====
static: $(STATIC_LIB_CLIENT) $(STATIC_LIB_JSON)

$(STATIC_LIB_CLIENT): $(OBJS_CLIENT)
	$(LIBTOOL) /OUT:$@ $**

$(STATIC_LIB_JSON): $(OBJS_JSON)
	$(LIBTOOL) /OUT:$@ $**

# ===== DYNAMIC LIBS =====
shared: $(DLL_CLIENT) $(DLL_JSON)

$(DLL_CLIENT): $(OBJS_CLIENT)
	$(LINK) $(LDFLAGS) /OUT:$@ /IMPLIB:$(IMPLIB_CLIENT) $(OBJS_CLIENT) libzmq-mt-4_3_5.lib

$(DLL_JSON): $(OBJS_JSON)
	$(LINK) $(LDFLAGS) /OUT:$@ /IMPLIB:$(IMPLIB_JSON) $(OBJS_JSON) libzmq-mt-4_3_5.lib jsoncpp.lib

# ===== VARIANT BUILDS =====
variants: $(VARIANT_DLLS)

$(LIBDIR)\multiverse_client_zmq.dll: $(SRCS_CLIENT)
	@echo Building variant zmq ...
	$(CC) $(CFLAGS) $(DEFS_zmq) /Fo"multiverse_client_zmq.obj" $(SRCS_CLIENT)
	$(LINK) $(LDFLAGS) /OUT:$@ /IMPLIB:$(LIBDIR)\multiverse_client_zmq.lib multiverse_client_zmq.obj libzmq-mt-4_3_5.lib

$(LIBDIR)\multiverse_client_tcp.dll: $(SRCS_CLIENT)
	@echo Building variant tcp ...
	$(CC) $(CFLAGS) $(DEFS_tcp) /Fo"multiverse_client_tcp.obj" $(SRCS_CLIENT)
	$(LINK) $(LDFLAGS) /OUT:$@ /IMPLIB:$(LIBDIR)\multiverse_client_tcp.lib multiverse_client_tcp.obj libzmq-mt-4_3_5.lib

$(LIBDIR)\multiverse_client_udp.dll: $(SRCS_CLIENT)
	@echo Building variant udp ...
	$(CC) $(CFLAGS) $(DEFS_udp) /Fo"multiverse_client_udp.obj" $(SRCS_CLIENT)
	$(LINK) $(LDFLAGS) /OUT:$@ /IMPLIB:$(LIBDIR)\multiverse_client_udp.lib multiverse_client_udp.obj libzmq-mt-4_3_5.lib

$(LIBDIR)\multiverse_client_all.dll: $(SRCS_CLIENT)
	@echo Building variant all ...
	$(CC) $(CFLAGS) $(DEFS_all) /Fo"multiverse_client_all.obj" $(SRCS_CLIENT)
	$(LINK) $(LDFLAGS) /OUT:$@ /IMPLIB:$(LIBDIR)\multiverse_client_all.lib multiverse_client_all.obj libzmq-mt-4_3_5.lib

$(LIBDIR)\multiverse_client_json_zmq.dll: $(SRCS_JSON)
	@echo Building JSON variant zmq ...
	$(CC) $(CFLAGS) $(DEFS_zmq) /Fo"multiverse_client_json_zmq.obj" $(SRCS_JSON)
	$(LINK) $(LDFLAGS) /OUT:$@ /IMPLIB:$(LIBDIR)\multiverse_client_json_zmq.lib multiverse_client_json_zmq.obj libzmq-mt-4_3_5.lib jsoncpp.lib

$(LIBDIR)\multiverse_client_json_tcp.dll: $(SRCS_JSON)
	@echo Building JSON variant tcp ...
	$(CC) $(CFLAGS) $(DEFS_tcp) /Fo"multiverse_client_json_tcp.obj" $(SRCS_JSON)
	$(LINK) $(LDFLAGS) /OUT:$@ /IMPLIB:$(LIBDIR)\multiverse_client_json_tcp.lib multiverse_client_json_tcp.obj libzmq-mt-4_3_5.lib jsoncpp.lib

$(LIBDIR)\multiverse_client_json_udp.dll: $(SRCS_JSON)
	@echo Building JSON variant udp ...
	$(CC) $(CFLAGS) $(DEFS_udp) /Fo"multiverse_client_json_udp.obj" $(SRCS_JSON)
	$(LINK) $(LDFLAGS) /OUT:$@ /IMPLIB:$(LIBDIR)\multiverse_client_json_udp.lib multiverse_client_json_udp.obj libzmq-mt-4_3_5.lib jsoncpp.lib

$(LIBDIR)\multiverse_client_json_all.dll: $(SRCS_JSON)
	@echo Building JSON variant all ...
	$(CC) $(CFLAGS) $(DEFS_all) /Fo"multiverse_client_json_all.obj" $(SRCS_JSON)
	$(LINK) $(LDFLAGS) /OUT:$@ /IMPLIB:$(LIBDIR)\multiverse_client_json_all.lib multiverse_client_json_all.obj libzmq-mt-4_3_5.lib jsoncpp.lib

# ===== COMPILE RULE =====
.cpp.obj:
	$(CC) $(CFLAGS) $<

# ===== CLEAN =====
clean:
	del /Q *.obj *.lib *.dll *.exp
	del /Q $(LIBDIR)\multiverse_client_*.dll
	del /Q $(LIBDIR)\multiverse_client_*.lib
	@echo Clean complete.
